{
  "name": "cineforge-enterprise",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev --workspace apps/api\" \"npm:dev --workspace apps/web\"",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/api",
    "lint": "npm run lint --workspace apps/web && npm run lint --workspace apps/api",
    "seed": "npm run seed --workspace apps/api"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.11",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
